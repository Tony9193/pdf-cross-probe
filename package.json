{
  "name": "bom-compare",
  "private": true,
  "version": "1.0.0",
  "description": "Offline linked PDF viewer for hardware schematic and reference-designator review",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/search.test.ts",
    "test:viewer": "node --experimental-strip-types --test --test-concurrency=1 tests/viewer.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "test:desktop": "node --test tests/electron.test.mjs",
    "test:privacy": "node --test tests/public-source.test.mjs",
    "export:public": "node scripts/export-public.mjs",
    "audit:release": "node scripts/audit-distribution.mjs",
    "package:win": "npm run build && electron-builder --win zip --x64",
    "postpackage:win": "npm run audit:release"
  },
  "build": {
    "appId": "local.pdf.crossprobe",
    "productName": "PDF Cross Probe",
    "artifactName": "PDF-Cross-Probe-${version}-win-${arch}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release/1.0.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "extraFiles": [
      {
        "from": "portable",
        "to": ".",
        "filter": [
          "README.txt",
          "Start.cmd"
        ]
      },
      {
        "from": "node_modules/pdfjs-dist/LICENSE",
        "to": "PDFJS-LICENSE.txt"
      }
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "lucide-react": "^1.67.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3",
    "oxlint": "^1.89.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "playwright-core": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
